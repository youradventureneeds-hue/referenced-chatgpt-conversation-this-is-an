{
  "name": "the-great-indian-outdoors",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "scrape:excel": "node scripts/seedFromExcel.mjs",
    "test:scraper": "node --test scripts/seedFromExcel.test.mjs",
    "db:about": "node scripts/updateOrganizationAbout.mjs",
    "db:global": "node scripts/importGlobalOrganizations.mjs",
    "jobs:sync": "node scripts/syncJobs.mjs",
    "test:jobs": "node --test scripts/jobScraper.test.mjs",
    "instagram:sync": "node scripts/syncInstagram.mjs",
    "instagram:discover": "node scripts/discoverInstagramSources.mjs",
    "test:instagram": "node --test scripts/instagram.test.mjs",
    "test:admin": "node --test scripts/adminAccess.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "next": "^15.1.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
